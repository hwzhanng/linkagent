    elementType: text
    bounds: [300, 326, 300, 22]
    content:
      style: "$small"
      color: "$accent"
      text: "failure → observe again / 失败时回到观测"
      align: [center, middle]
      wrap: false
  - elementId: p3-safety-rule
    elementType: line
    bounds: [56, 410, 848, 2]
    viewBox: [1, 1]
    points: "0,0.5 1,0.5"
    border: {style: solid, width: 2, color: "$primary"}
  - elementId: p3-safety-label
    elementType: text
    bounds: [56, 426, 848, 46]
    content:
      style: "$body"
      text: |
        <p><strong>Hardware boundary / 真机边界：</strong> explicit opt-in · shadow FK/IK · motion limits · emergency stop</p>
        <p><span style="font-size:15px;color:$muted;">真机执行需要显式授权、Shadow 验证、运动限制和急停保护。</span></p>
      align: [left, top]
  - elementId: p3-page
    elementType: text
    bounds: [868, 480, 36, 20]
    content:
      style: "$small"
      color: "$primary"
      text: "03"
      align: [right, middle]
      wrap: false
