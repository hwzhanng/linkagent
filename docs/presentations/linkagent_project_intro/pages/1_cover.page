pageType: cover
background:
  type: solid
  color: "$primaryDeep"
notes: |
  [Sources]
  - Project scope: linkagent/README.md and linkagent/preview.md
  - No external photographs or claims are embedded on this page.
  [/Sources]
elements:
  - elementId: cover-kicker
    elementType: text
    bounds: [58, 58, 420, 26]
    content:
      style: "$kicker"
      text: "RESEARCH PLATFORM  /  研究平台"
      wrap: false
  - elementId: cover-rule
    elementType: shape
    bounds: [58, 103, 220, 3]
    shapeName: rect
    fill: {type: solid, color: "$accent"}
  - elementId: cover-title
    elementType: text
    bounds: [58, 128, 490, 184]
    content:
      style: "$coverTitle"
      text: |
        <p>LinkAgent</p>
        <p><span style="font-size:30px;color:$primaryTint;">Safe, Tactile, Dexterous</span></p>
        <p><span style="font-size:30px;color:$primaryTint;">Tomato Harvesting</span></p>
      align: [left, top]
  - elementId: cover-cn
    elementType: text
    bounds: [60, 338, 470, 70]
    content:
      style: "$coverSub"
      text: |
        <p>面向安全、触觉驱动的灵巧番茄采摘</p>
        <p><span style="font-size:16px;color:$muted;">From offline verification to future field deployment</span></p>
      align: [left, top]
  - elementId: cover-photo-placeholder
    elementType: shape
    bounds: [618, 68, 286, 342]
    shapeName: rect
    fill: {type: solid, color: "#214E3C"}
    border: {style: dash, width: 1.5, color: "$accent"}
  - elementId: cover-photo-placeholder-text
    elementType: text
    bounds: [650, 188, 220, 110]
    content:
      style: "$bodyMuted"
      color: "$primaryTint"
      text: |
        <p style="text-align:center"><strong>PHOTO / VIDEO PLACEHOLDER</strong></p>
        <p style="text-align:center">照片 / 视频占位</p>
        <p style="text-align:center"><span style="font-size:14px;">Insert project image here</span></p>
        <p style="text-align:center"><span style="font-size:14px;">此处替换项目实拍</span></p>
      align: [center, middle]
  - elementId: cover-meta
    elementType: text
    bounds: [60, 474, 760, 28]
    content:
      style: "$small"
      color: "$primaryTint"
      text: "LinkAgent  ·  Robotics / Tactile Sensing / Reinforcement Learning  ·  2026"
      wrap: false
  - elementId: cover-page
    elementType: text
    bounds: [868, 480, 36, 20]
    content:
      style: "$small"
      color: "$accent"
      text: "01"
      align: [right, middle]
      wrap: false

